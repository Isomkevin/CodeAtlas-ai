CODEATLAS_ENVIRONMENT=development
CODEATLAS_ALLOWED_ORIGINS=["http://localhost:5173"]
CODEATLAS_DATABASE_URL=postgresql+psycopg://codeatlas:codeatlas@localhost:5432/codeatlas
CODEATLAS_NEO4J_URI=bolt://localhost:7687
CODEATLAS_REDIS_URL=redis://localhost:6379/0
CODEATLAS_JWT_SECRET=replace-with-a-unique-32-character-secret
CODEATLAS_JWT_ISSUER=codeatlas
CODEATLAS_JWT_AUDIENCE=codeatlas-web
CODEATLAS_GITHUB_CLIENT_ID=
CODEATLAS_GITHUB_CLIENT_SECRET=
CODEATLAS_GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
CODEATLAS_LOG_LEVEL=INFO
